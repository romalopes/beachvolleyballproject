# VITE_API_URL
# ------------
# Set this to the base URL of your deployed Rails API.
# In local development the Vite proxy handles this automatically,
# so you only need this for production / external deployments.
#
# Examples:
#   VITE_API_URL=https://api.example.com/api/v1
#   VITE_API_URL=http://localhost:3001/api/v1
#
# When unset, defaults to "/api/v1" (Vite dev proxy).
# VITE_API_URL=